{
  "name": "serveja-desktop",
  "productName": "ServeJa",
  "version": "1.0.0",
  "description": "ServeJa - sistema desktop com impressão direta",
  "main": "main.js",
  "author": "Jardel",
  "scripts": { "start": "electron .", "dist": "electron-builder --win --x64" },
  "devDependencies": { "electron": "^33.2.0", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "br.com.serveja.app",
    "productName": "ServeJa",
    "files": ["main.js", "preload.js", "offline.html"],
    "directories": { "output": "dist" },
    "win": { "target": "nsis" },
    "nsis": { "oneClick": true, "perMachine": false, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "ServeJa" }
  }
}
